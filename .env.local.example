# Klucz dostępu Web3Forms (formularz kontaktowy).
# 1. Wejdź na https://web3forms.com
# 2. W pole "Email Address" wpisz: kontakt@programujzmateuszem.pl
# 3. Skopiuj otrzymany Access Key i wklej poniżej.
# Klucz jest publiczny (trafia do kodu klienta) — to normalne dla Web3Forms.
NEXT_PUBLIC_WEB3FORMS_KEY=

# (opcjonalnie) Bazowy URL strony — używany w metadanych SEO, sitemap, OG.
# NEXT_PUBLIC_SITE_URL=https://programujzmateuszem.pl

# (opcjonalnie) Webhook powiadomień o nowym zamówieniu w sklepie.
# Wklej URL webhooka Discord / Slack / Mattermost (albo dowolny endpoint
# przyjmujący POST JSON). Pusty = powiadomienia wyłączone.
# ORDER_WEBHOOK_URL=

# (opcjonalnie) Automatyczne opinie z Google na stronie głównej (Places API — New).
# Google Cloud Console → włącz „Places API (New)" → Credentials → API key
# (ogranicz klucz do Places API). Bez klucza strona pokazuje listę z lib/testimonials.ts.
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=   # opcjonalnie; bez tego miejsce szukane po nazwie firmy
