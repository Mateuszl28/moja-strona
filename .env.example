# Skopiuj ten plik jako .env.local i uzupełnij wartości.
# .env.local nigdy nie trafia do gita (jest w .gitignore).

# Klucz API z https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twój adres email - tu będą trafiać wiadomości z formularza
CONTACT_EMAIL=twoj-email@example.com

# Opcjonalnie: adres "from" w wysyłanych mailach
# - bez własnej domeny: zostaw onboarding@resend.dev (działa od razu)
# - z własną domeną zweryfikowaną w Resend: np. kontakt@twojadomena.pl
RESEND_FROM=onboarding@resend.dev
