# Skopiuj ten plik jako .env.local i uzupełnij wartości.
# .env.local nigdy nie trafia do gita (jest w .gitignore).

# ───── Wymagane do formularza kontaktowego ─────
# Klucz API z https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twój adres email - tu trafiają wiadomości z formularza
CONTACT_EMAIL=lagockimateusz6@gmail.com

# Adres "from" - bez własnej domeny zostaw default
RESEND_FROM=onboarding@resend.dev

# ───── Newsletter (Resend Audiences) ─────
# https://resend.com/audiences -> Create Audience, skopiuj ID
RESEND_AUDIENCE_ID=

# ───── AI Chatbot ─────
# https://aistudio.google.com/apikey - generuj klucz
GEMINI_API_KEY=

# ───── Adres strony (do SEO/OG/sitemap) ─────
NEXT_PUBLIC_SITE_URL=http://85.215.197.199

# ───── Analytics (Plausible) - opcjonalne ─────
# Po założeniu konta na plausible.io
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Custom script URL (jeśli używasz self-hosted Plausible / Umami)
NEXT_PUBLIC_PLAUSIBLE_SCRIPT=

# ───── Giscus comments - opcjonalne ─────
# Konfiguracja na https://giscus.app po włączeniu Discussions w repo
NEXT_PUBLIC_GISCUS_REPO=Mateuszl28/moja-strona
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=General
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
